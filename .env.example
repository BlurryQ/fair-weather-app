# --- Weather API (Netlify function) ---
WEATHER_API=YOUR_WEATHER_API_KEY

# --- Appwrite (frontend) ---
# Endpoint for the region the project was created in (EU = Frankfurt).
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
VITE_APPWRITE_DATABASE_ID=main
VITE_APPWRITE_BUCKET_ID=images

# --- Migration scripts only (never commit real values) ---
# Appwrite server API key with users + databases + storage scopes.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=YOUR_SERVER_API_KEY
APPWRITE_DATABASE_ID=main

# Supabase source (export only).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Postgres connection string from Supabase dashboard > Settings > Database.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
