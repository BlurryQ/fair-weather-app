{
  "name": "fair-weather-app",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://{username}.github.io/{repo-name}/",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate:setup": "node --env-file=.env scripts/setup-appwrite.mjs",
    "migrate:export": "node --env-file=.env scripts/export-supabase.mjs",
    "migrate:import": "node --env-file=.env scripts/import-appwrite.mjs"
  },
  "dependencies": {
    "@netlify/functions": "^4.2.5",
    "appwrite": "^16.0.2",
    "axios": "^1.7.7",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-password-checklist": "^1.8.1",
    "react-router-dom": "^7.4.1",
    "react-spinners": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "node-appwrite": "^14.1.0",
    "pg": "^8.13.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^6.2.0",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^7.1.3"
  }
}
